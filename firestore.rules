rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "felip0fonseca@gmail.com";
    }

    match /articles/{articleId} {
      // O site público só lê matérias publicadas.
      allow read: if resource.data.status == "published" || isAdmin();

      // Somente seu usuário da redação pode criar/editar/apagar.
      allow create, update, delete: if isAdmin();
    }

    match /articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
